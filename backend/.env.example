# --- Option A: Gemini Developer API (fastest to set up) ---------------
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# --- Option B: Vertex AI (uses your existing GCP project) --------------
# Uncomment these instead of GEMINI_API_KEY if you want to use the GCP
# credentials/project you already have.
# GOOGLE_GENAI_USE_VERTEXAI=true
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# GOOGLE_CLOUD_LOCATION=us-central1
# GOOGLE_APPLICATION_CREDENTIALS=/app/service-account.json

# Optional: override the default model
# GEMINI_MODEL=gemini-2.5-flash

# --- Security (strongly recommended once deployed publicly) ------------
# Shared secret required in the X-App-Secret header. Pick any long random
# string (e.g. `openssl rand -hex 32`). Enter the SAME value in the PWA's
# settings panel — it's stored in localStorage, never in this repo.
# If unset, the endpoint is open to anyone who finds the URL.
APP_SECRET=

# Per-IP rate limit (resets on redeploy/cold start). Defaults shown.
# RATE_LIMIT_MAX_REQUESTS=20
# RATE_LIMIT_WINDOW_SECONDS=3600

# Max upload size in MB. Default shown.
# MAX_UPLOAD_MB=8
